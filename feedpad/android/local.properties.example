# Bu dosya local.properties.example olarak kaydedilmiştir.
# Kendi local.properties dosyanızı oluşturmak için bu dosyayı kopyalayın:
# cp local.properties.example local.properties
# 
# Sonra MAPS_API_KEY değerini kendi API key'inizle değiştirin.

sdk.dir=C:\\Users\\YOUR_USERNAME\\AppData\\Local\\Android\\sdk
flutter.sdk=C:\\path\\to\\flutter
flutter.buildMode=debug
flutter.versionName=1.0.0
flutter.versionCode=1

# Google Maps API Key
# Bu değeri kendi Google Maps API key'inizle değiştirin
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

