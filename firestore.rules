rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Yeni kullanıcı: kendi profilini oluşturabilir (Cloud Function tarafından otomatik yapılır)
    // Ama bu kural da istemci tarafından manuel profil oluşturma için gerekirse aktif kalır.
    match /users/{userId} {
      // Kullanıcı kendi profilini okuyabilir
      allow read: if request.auth.uid == userId;
      
      // Kullanıcı kendi profilini güncelleyebilir
      allow update: if request.auth.uid == userId;
      
      // Yeni profil oluşturmak için: uid eşleşmeli (Cloud Function tarafından yapılır)
      allow create: if request.auth.uid == userId;
      
      // Silme kuralı: profil silinemez (opsiyonel; gerekirse aktif et)
      allow delete: if false;
    }
  }
}
